# ====================================================================
# REDACTIFY ENVIRONMENT CONFIGURATION (.env.example)
# Add these environment variables to your Vercel Project Settings:
# (Vercel Dashboard -> Project -> Settings -> Environment Variables)
# ====================================================================

# 1. Asymmetric Cryptographic License Signing Key (ECDSA P-256)
# Kept securely on serverless functions. Never exposed to browser.
LICENSE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgcP3vZF819UADxXRA\nXGj1B3NsmoamCjiifT/RQjpC67uhRANCAAT021nJ6fehYbvkxYGCU4SL0t6EbHKi\nlBILQv+SNAAhNFByF3Th9X4JqJBuQDMk5Oe4uNecvTMrB4mnLgBU6XiY\n-----END PRIVATE KEY-----"

# 2. Razorpay Credentials (from Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_or_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Razorpay Webhook Secret (from Razorpay Dashboard -> Settings -> Webhooks)
# Set Webhook URL to: https://yourdomain.com/api/razorpay-webhook
# Active Events: refund.processed, refund.created, payment.dispute.created, payment.dispute.lost
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# 3. Supabase Configuration (from Supabase Dashboard -> Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
# CRITICAL: Use the 'service_role' secret key here so serverless functions can write to tables
SUPABASE_SERVICE_KEY=your_supabase_service_role_secret_key_here

# 4. Resend Email Service (from resend.com -> API Keys)
RESEND_API_KEY=re_your_resend_api_key_here
FEEDBACK_TO_EMAIL=sakthivel.hsr06@gmail.com

# 5. Allowed CORS Origins
ALLOWED_ORIGINS=https://redactify.daeq.in,http://localhost:5173,http://localhost:3000
